{
  "name": "tiv-songs-platform",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm:dev:*\"",
    "dev:web": "npm --workspace @tiv-songs/web run dev",
    "dev:api": "npm --workspace @tiv-songs/api run dev",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces",
    "db:generate": "npm --workspace @tiv-songs/api run db:generate",
    "db:migrate": "npm --workspace @tiv-songs/api run db:migrate",
    "db:deploy": "npm --workspace @tiv-songs/api run db:deploy",
    "db:local:setup": "npm --workspace @tiv-songs/api run db:local:setup"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.3",
    "next": {
      "postcss": "8.5.23",
      "sharp": "0.35.3"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  }
}
