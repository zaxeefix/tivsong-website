NODE_ENV=development
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000/api
NEXT_PUBLIC_API_URL=/api
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tiv_songs
# Production migrations: use Neon's direct connection hostname (without -pooler).
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/tiv_songs
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
JWT_ACCESS_SECRET=replace-with-32-plus-random-characters
JWT_REFRESH_SECRET=replace-with-another-32-plus-random-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30
ADMIN_EMAIL=admin@tivsongs.local
ADMIN_PASSWORD=change-this-admin-password
SUPER_ADMIN_EMAIL=owner@tivsongs.local
SUPER_ADMIN_PASSWORD=change-this-super-admin-password
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=1024
MAX_TRANSCODES=2
VIRUS_SCAN_URL=
# Use local only for development. Production startup requires s3.
STORAGE_PROVIDER=local
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CLOUDINARY_URL=
S3_ENDPOINT=
# Backblaze B2 example: us-east-005 (use the region shown beside your bucket)
S3_REGION=us-east-005
S3_BUCKET=tiv-songs-beta
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
